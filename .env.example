# Environment (development | staging | production)
ENV=development

# HTTP Server (use SERVER_HOST=0.0.0.0 only behind a TLS-terminating reverse proxy or in a container)
SERVER_HOST=127.0.0.1
SERVER_PORT=8080
SERVER_READ_TIMEOUT=10s
SERVER_WRITE_TIMEOUT=30s
SERVER_IDLE_TIMEOUT=60s
SERVER_SHUTDOWN_TIMEOUT=15s
# When TRUST_PROXY=true, X-Forwarded-For is honored only from these addresses/CIDRs (comma-separated).
TRUST_PROXY=false
TRUSTED_PROXY_CIDRS=
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Rate Limiting (values must be positive)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_RPS=20
RATE_LIMIT_BURST=40
AUTH_RATE_LIMIT_RPS=2
AUTH_RATE_LIMIT_BURST=5

# Local infrastructure credentials (read by docker-compose.yml; no defaults are provided)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-local-postgres-password
POSTGRES_DB=farm_fusion
RABBITMQ_USER=farmfusion
RABBITMQ_PASS=replace-with-a-local-rabbitmq-password

# Database (production requires sslmode=verify-full, or verify-ca with sslrootcert)
DATABASE_URL=postgres://postgres:replace-with-a-local-postgres-password@127.0.0.1:5432/farm_fusion?sslmode=disable
DB_MAX_CONNS=10
DB_MIN_CONNS=2
DB_STATEMENT_TIMEOUT=30s

# JWT Authentication. The example value below is rejected; generate via: openssl rand -hex 32
JWT_SECRET=replace-with-a-secure-random-32-byte-secret-key
JWT_ISSUER=farm-fusion-api
JWT_AUDIENCE=farm-fusion-client
# Access tokens: at most 15m. Refresh tokens: at most 720h (30 days).
ACCESS_TOKEN_DURATION=15m
REFRESH_TOKEN_DURATION=168h

# Internal Python ML Service. Required by both the API and the ML service (min 32 bytes).
# The example value below is rejected; generate via: openssl rand -hex 32
ML_SERVICE_URL=http://127.0.0.1:8000
ML_API_KEY=replace-with-a-secure-random-32-byte-ml-api-key
ML_TIMEOUT=10s

# Redis (password required by docker-compose.yml)
REDIS_URL=
REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=replace-with-a-local-redis-password
REDIS_DB=0

# RabbitMQ (must match RABBITMQ_USER / RABBITMQ_PASS above; guest is rejected in production)
RABBITMQ_URL=amqp://farmfusion:replace-with-a-local-rabbitmq-password@127.0.0.1:5672/
RABBITMQ_PORT=5672
RABBITMQ_QUEUE=weather.notifications

# OpenWeather API
OPENWEATHER_API_KEY=your-api-key-here
OPENWEATHER_BASE_URL=https://api.openweathermap.org/data/2.5/forecast
# Forecast cache lifetime in seconds (must be > 0)
WEATHER_CACHE_TTL=10800

# SMTP (Outgoing Email)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-gmail@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=your-gmail@gmail.com
SMTP_REQUIRE_TLS=true
SMTP_TIMEOUT=15s

# Scheduler (daily run at SCHEDULER_HOUR:00 in SCHEDULER_TIMEZONE, an IANA zone name)
SCHEDULER_HOUR=5
SCHEDULER_TIMEZONE=Asia/Dhaka
SCHEDULER_RUN_ONCE=false
