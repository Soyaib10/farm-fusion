# Environment (development | staging | production)
ENV=development

# HTTP Server
SERVER_HOST=
SERVER_PORT=8080
SERVER_READ_TIMEOUT=10s
SERVER_WRITE_TIMEOUT=30s
SERVER_IDLE_TIMEOUT=60s
SERVER_SHUTDOWN_TIMEOUT=15s
TRUST_PROXY=false
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_RPS=20
RATE_LIMIT_BURST=40
AUTH_RATE_LIMIT_RPS=2
AUTH_RATE_LIMIT_BURST=5

# Database
DATABASE_URL=postgres://postgres:password@127.0.0.1:5432/farm_fusion?sslmode=disable
DB_MAX_CONNS=10
DB_MIN_CONNS=2

# JWT Authentication (MUST be at least 32 characters; generate via: openssl rand -hex 32)
JWT_SECRET=replace-with-a-secure-random-32-byte-secret-key
JWT_ISSUER=farm-fusion-api
JWT_AUDIENCE=farm-fusion-client
ACCESS_TOKEN_DURATION=15m
REFRESH_TOKEN_DURATION=168h

# Internal Python ML Service
ML_SERVICE_URL=http://127.0.0.1:8000
ML_API_KEY=
ML_TIMEOUT=10s

# Redis
REDIS_URL=
REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=
REDIS_DB=0

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@127.0.0.1:5672/
RABBITMQ_QUEUE=weather.notifications

# OpenWeather API
OPENWEATHER_API_KEY=your-api-key-here
OPENWEATHER_BASE_URL=https://api.openweathermap.org/data/2.5/forecast
WEATHER_CACHE_TTL=10800

# SMTP (Outgoing Email)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-gmail@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=your-gmail@gmail.com
SMTP_REQUIRE_TLS=true
SMTP_TIMEOUT=15s

# Scheduler
SCHEDULER_RUN_ONCE=false
