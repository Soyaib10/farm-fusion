# Server
SERVER_PORT=8080

# Database
DATABASE_URL=postgres://postgres:password@localhost:5432/farm_fusion?sslmode=disable
DB_MAX_CONNS=10
DB_MIN_CONNS=2

# JWT
JWT_SECRET=change-me-in-production
ACCESS_TOKEN_DURATION=15m
REFRESH_TOKEN_DURATION=168h

# ML Service
ML_SERVICE_URL=http://localhost:8000

# Redis
REDIS_URL=                          # optional, takes priority over REDIS_ADDR if set
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
RABBITMQ_QUEUE=weather.notifications

# OpenWeather API
OPENWEATHER_API_KEY=your-api-key-here
OPENWEATHER_BASE_URL=https://api.openweathermap.org/data/2.5/forecast
WEATHER_CACHE_TTL=10800             # seconds (3 hours)

# SMTP (Gmail)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-gmail@gmail.com
SMTP_PASSWORD=your-app-password     # use Gmail App Password, not account password
SMTP_FROM=your-gmail@gmail.com

# Scheduler (optional)
SCHEDULER_RUN_ONCE=false            # set true to run once and exit (useful for testing)
